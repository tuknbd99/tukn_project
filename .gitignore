.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
*.pem
*.key
*.crt
*.p12
secrets/
credentials/

# 📦 ডিপেন্ডেন্সি
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# 🏗️ বিল্ড ও ডিস্ট্রিবিউশন
dist/
build/
out/
*.min.js
*.min.css
*.bundle.js
*.chunk.js
.cache/
.parcel-cache/
.next/
.nuxt/

# 💻 IDE ও এডিটর
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.iml
*.iws
*.ipr

# 📝 লগ ও টেম্পোরারি
*.log
logs/
*.log.*
*.tmp
*.temp
tmp/
temp/
*.cache

# 💾 ডেটাবেস
*.sqlite
*.sqlite3
*.db
*.db3
.supabase/
*_supabase_backup*.json

# 📂 আপলোড ও মিডিয়া
profile-images/
uploads/
media/
images/uploads/

# 🧪 টেস্টিং
coverage/
.nyc_output/
test-results/
*.test.js
*.spec.js

# 📦 আর্কাইভ
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z
*.gz
*.bz2

# 🔧 অন্যান্য
*.backup
*.bak
*.old
*-backup.*
backup_*.json
*.local
*.user
*.userprefs
*.pcap
*.cap
*.dll
*.exe
*.pdb

